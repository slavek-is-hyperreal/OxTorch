#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    uint M;             // Rows of A / Rows of C
    uint N;             // Cols of B / Cols of C
    uint K;             // Cols of A / Rows of B
    uint stride_row_a;
    uint stride_col_a;
    uint stride_row_b;
    uint stride_col_b;
    uint stride_row_c;
    uint stride_col_c;
    uint offset_a;
    uint offset_b;
} pc;

layout(set = 0, binding = 0) buffer MatrixA { float a[]; };
layout(set = 0, binding = 1) buffer MatrixB { float b[]; };
layout(set = 0, binding = 2) buffer MatrixC { float c[]; };

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;

    if (row < pc.M && col < pc.N) {
        float acc = 0.0;
        for (uint k = 0; k < pc.K; ++k) {
            uint idx_a = pc.offset_a + (row * pc.stride_row_a) + (k * pc.stride_col_a);
            uint idx_b = pc.offset_b + (k * pc.stride_row_b) + (col * pc.stride_col_b);
            acc += a[idx_a] * b[idx_b];
        }
        
        uint idx_c = (row * pc.stride_row_c) + (col * pc.stride_col_c);
        c[idx_c] = acc;
    }
}
